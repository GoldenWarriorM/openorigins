{
  "schemaVersion": 1,
  "id": "openorigins",
  "version": "${version}",
  "name": "OpenOrigins",
  "description": "Re-implementation of Origins Enhanced for modern minecraft versions.",
  "authors": [
    "open-origins"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.openorigins.client.OpenOriginsClient"
    ],
    "modmenu": [
      "com.openorigins.client.ModMenuIntegration"
    ]
  },
  "mixins": [
    {
      "config": "openorigins.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  },
  "icon": "assets/openorigins/textures/gui/sprites/mod_icon.png"
}
